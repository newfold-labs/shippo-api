{
    "name": "newfold-labs/shippo-api",
    "description": "Modern PHP client for the Shippo REST API",
    "version": "1.0.1",
    "type": "library",
  "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Bluehost\\ShippoAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bluehost\\ShippoAPI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "analyse": "phpstan analyse -c phpstan.neon",
        "lint": "phpcs --warning-severity=0",
        "ci": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ]
    },
    "config": {
        "platform": {
            "php": "8.0.0"
        },
        "sort-packages": true
    }
}
